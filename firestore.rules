rules_version = '2';

// These rules apply to the three collections this app uses:
// orders, reviews, and config (restaurant details + menu).
//
// The app has no real user login — access is controlled only by the
// staff/owner PIN screens inside the app itself, which is a UI-level
// gate, not a database-level one. So these rules allow open read/write
// on these three collections (same effective openness as Firestore's
// "test mode", but permanent instead of expiring after 30 days).
//
// This is fine to start with. If you want real database-level security
// later (e.g. only logged-in staff can change order status), that
// requires adding Firebase Authentication — a separate, bigger change,
// not part of this fix.
service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow read, write: if true;
    }
    match /reviews/{reviewId} {
      allow read, write: if true;
    }
    match /config/{configId} {
      allow read, write: if true;
    }
    // Block everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
